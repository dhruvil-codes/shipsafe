# ==============================================================================
# ShipSafe Environment Configuration
# ==============================================================================

# InstaBox Cloud Micro-VM (https://instabox.sh/docs)
# Obtain your API key from the InstaBox dashboard or CLI (instabox whoami)
INSTABOX_API_KEY=ibk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# The Sandbox ID of your dedicated, persistent micro-VM (e.g. sbx_xxxxxxxx)
INSTABOX_SANDBOX_ID=sbx_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: API base URL (defaults to https://api.box.instacloud.com)
INSTABOX_SERVER=https://api.box.instacloud.com

# Sandbox Provider Selection
# Use 'instabox' for real execution on the cloud micro-VM, or 'fake' for offline testing
SANDBOX_PROVIDER=instabox

# App & Server Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in Vercel production; keep the real value in encrypted server settings.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# SHIPSAFE_DURABLE_DISPATCH=workflow
# Optional explicit World selection. Never use "local" on Vercel.
# WORKFLOW_TARGET_WORLD=vercel
# The fixed private lab stays disabled in public production by default.
SHIPSAFE_LAB_ENABLED=0
