{
  "name": "shipsafe",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @shipsafe/web dev",
    "build": "bun --filter \"*\" build",
    "test": "bun --filter \"*\" test",
    "typecheck": "bun --filter \"*\" typecheck",
    "lint": "bun --filter \"*\" lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
